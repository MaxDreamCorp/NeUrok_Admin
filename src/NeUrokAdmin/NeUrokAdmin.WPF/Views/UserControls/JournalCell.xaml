<UserControl x:Class="NeUrokAdmin.WPF.Views.UserControls.JournalCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NeUrokAdmin.WPF.Views.UserControls"
             mc:Ignorable="d" >
        <Button x:Name="MC" 
                Style="{StaticResource JournalCellButtonStyle}"
                MouseDoubleClick="MC_MouseDoubleClick">
            <TextBlock Text="{Binding Attendance.Mark}"
                       Margin="3"
                  FontWeight="DemiBold"
                  FontSize="12"/>
        </Button>
</UserControl>
