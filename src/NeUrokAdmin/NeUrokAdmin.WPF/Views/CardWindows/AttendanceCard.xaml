<Window x:Class="NeUrokAdmin.WPF.Views.CardWindows.AttendanceCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeUrokAdmin.WPF.Views.CardWindows"
        mc:Ignorable="d"
         MinWidth="480"
         SizeToContent="WidthAndHeight"
         Loaded="Window_Loaded"
         Title="Группа">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                  Orientation="Horizontal">
            <Button x:Name="BackBtn" 
                  Style="{StaticResource SecondaryBtn}" 
                  Content="Назад"
                  Click="BackBtn_Click"/>
            <TextBlock Style="{StaticResource HeaderText}"
                     Text="Отметка посещения"
                     Margin="10 0 0 0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" 
                  Margin="0 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Ученик:" 
                        Grid.Row="0" 
                        Style="{StaticResource CardTextBlock}"/>
                <Border Style="{StaticResource TblockBorder}"
                        Grid.Row="0" 
                        Grid.Column="1" 
                        Margin="0,5" >
                    <TextBlock Text="{Binding Student.Client.ChildFullname}" 
                          FontSize="14"/>
                </Border>

                <TextBlock Text="Группа:" 
                        Grid.Row="1" 
                        Style="{StaticResource CardTextBlock}"
                           Visibility="{Binding IsGroup, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVis}}"/>
                <Border Style="{StaticResource TblockBorder}"
                        Grid.Row="1" 
                        Grid.Column="1" 
                        Margin="0,5" 
                        Visibility="{Binding IsGroup, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Group.Name}" 
                          FontSize="14"/>
                </Border>

                <DockPanel Grid.Row="2"
                           Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Дата и время:" 
                                   Style="{StaticResource CardTextBlock}" Margin="0,5,55,5"/>
                        <Border Style="{StaticResource TblockBorder}"
                                x:Name="DatetimeTextBox"
                                Margin="0,5" >
                            <TextBlock Text="{Binding Datetime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" 
                                       MinWidth="105"
          FontSize="14"/>
                        </Border>
                        <StackPanel x:Name="WorkingOffSetTimePanel"
                                    Visibility="Collapsed">
                        <DatePicker SelectedDate="{Binding NewDatetime, UpdateSourceTrigger=PropertyChanged}" 
          
             Margin="0,5" 
             Style="{StaticResource DatePicker}"/>
                            <StackPanel Grid.Row="7"
            Grid.Column="1"
            Orientation="Horizontal">
                                <ComboBox SelectedItem="{Binding TimeHours, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Hours}"
              IsEditable="True"
              Width="40"
              StaysOpenOnEdit="True"/>
                                <TextBlock Text=":"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"
               Margin="3 0"/>
                                <ComboBox SelectedItem="{Binding TimeMinutes, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Minutes}"
              IsEditable="True"
              Width="40"
              StaysOpenOnEdit="True"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="20,0,0,0">
                        <TextBlock Text="Вид занятий:" 
                                   Style="{StaticResource CardTextBlock}"/>
                        <Border Style="{StaticResource TblockBorder}"
                                                                Margin="0,5" >
                            <TextBlock Text="{Binding ClassesType.Type}" 
                                       MinWidth="105"
          FontSize="14" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                
                
                <TextBlock Text="Курс:" 
                            Grid.Row="3"
                            Style="{StaticResource CardTextBlock}"/>
                <Border Style="{StaticResource TblockBorder}"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,5" >
                    <TextBlock Text="{Binding Course.Name}" 
                                MinWidth="105"
    FontSize="14"/>
                </Border>
                        
                <TextBlock Text="Педагог:" 
                            Grid.Row="4"
                            Style="{StaticResource CardTextBlock}"/>
            <Border Style="{StaticResource TblockBorder}"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,5" >
                <TextBlock Text="{Binding Teacher.Fullname}" 
                                MinWidth="105"
                                FontSize="14"/>
            </Border>
                        
                <TextBlock Text="Тип:" 
                            Grid.Row="5"
                            Style="{StaticResource CardTextBlock}"/>
            <Border Style="{StaticResource TblockBorder}"
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,5" >
                <TextBlock Text="{Binding Type.Type}" 
                                MinWidth="105"
                                FontSize="14"/>
            </Border>

                <TextBlock Text="Проведено:" 
                            Grid.Row="6" 
                            Style="{StaticResource CardTextBlock}"/>
                <CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" 
                          Grid.Row="6" 
                          Grid.Column="1" 
                          Margin="0,5" 
                          Background="{StaticResource InpBg}"
                          BorderBrush="{StaticResource DarkPinkBg}"
                          BorderThickness="1.5"
                          Checked="CheckBox_Checked"
                          Unchecked="CheckBox_Unchecked"/>

                <TextBlock Text="Статус:" 
                           Grid.Row="7"
                           Style="{StaticResource CardTextBlock}"/>
                <ComboBox SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" 
                            ItemsSource="{Binding AttendanceStatuses, UpdateSourceTrigger=PropertyChanged}" 
                          SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ModernComboBox}"
                            Grid.Row="7" 
                            Grid.Column="1" 
                            Margin="0,5" />

                <TextBlock Text="Причина:"
                           Visibility="Collapsed"
                           x:Name="CauseLb"
                           VerticalAlignment="Top"
                           Grid.Row="8"
                           Style="{StaticResource CardTextBlock}"/>
                <TextBox Text="{Binding AbsentCause, TargetNullValue=''}" 
                         x:Name="CauseTxt"
                         Visibility="Collapsed" 
                         Style="{StaticResource Tbox}"
                         Grid.Row="8"
                         Grid.Column="1"
                         Margin="0 5"
                         MinHeight="60" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"/> 

                <TextBlock Text="Цена занятия:" 
            Grid.Row="9" 
            Style="{StaticResource CardTextBlock}"/>
                <TextBox Text="{Binding Price, StringFormat='{}{0:N2}', TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
          Grid.Row="9" 
          Grid.Column="1" 
          Margin="0,5" 
          Style="{StaticResource Tbox}"/>

                <TextBlock Text="Доля преподавателю:" 
            Grid.Row="10" 
            Style="{StaticResource CardTextBlock}"/>
                <TextBox Text="{Binding TeacherShare, StringFormat='{}{0:N2}', TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
          Grid.Row="10" 
          Grid.Column="1" 
          Margin="0,5" 
          Style="{StaticResource Tbox}"/>

                <TextBlock Text="Заметки:"
                           VerticalAlignment="Top"
                           Grid.Row="11"
                           Style="{StaticResource CardTextBlock}"/>
                <TextBox Text="{Binding Notes, TargetNullValue=''}" 
                         Style="{StaticResource Tbox}"
                         Grid.Row="11"
                         Grid.Column="1"
                         Margin="0 5"
                         MinHeight="60" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"/> 
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CreateWorkOffBtn" 
                    Style="{StaticResource SecondaryBtn}" 
                    HorizontalAlignment="Right"
                        Margin="0 0 10 0"
                    Content="Создать отработку"
                    Click="CreateWorkOffBtn_Click"/>
                <Button x:Name="AcceptBtn" 
                    Style="{StaticResource PrimaryBtn}" 
                    HorizontalAlignment="Right"
                    Content="Подтвердить"
                    Click="AcceptBtn_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
