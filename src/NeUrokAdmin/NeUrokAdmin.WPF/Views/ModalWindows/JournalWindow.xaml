<Window x:Class="NeUrokAdmin.WPF.Views.ModalWindows.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeUrokAdmin.WPF.Views.ModalWindows"
        mc:Ignorable="d"
        Title="Журнал" 
        MinHeight="450" 
        MinWidth="800"
        Loaded="Window_Loaded"
        SizeToContent="WidthAndHeight">
    <Grid >

        <DockPanel Background="{StaticResource MainBg}">

            <Border DockPanel.Dock="Top" 
                Background="White" 
                CornerRadius="8" 
                Margin="10,10,10,0" 
                Padding="5,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="{StaticResource DarkPinkBg}" 
                                CornerRadius="4" 
                                Padding="8,4" 
                                Margin="0,0,10,0">
                                <TextBlock Text="{Binding Group.Name, FallbackValue='Группа'}" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="13"/>
                            </Border>
                            <Border Background="{StaticResource InpBg}" 
                                CornerRadius="4" 
                                Padding="6,4"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Group.GroupStatus.Status, FallbackValue='Активна'}" 
                                       Foreground="#555555" 
                                       FontSize="11" 
                                       FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Group.Course.Name, FallbackValue='Курс не указан'}" 
                               Foreground="{StaticResource VeryDarkPinkBg}" 
                               FontSize="12" 
                               FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Преподаватель" 
                               Foreground="#888888" 
                               FontSize="11" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Group.Teacher.Fullname, FallbackValue='Не назначен'}" 
                               Foreground="#222222" 
                               FontSize="12" 
                               FontWeight="Medium"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Border Background="{StaticResource PalePink}" 
                            CornerRadius="6" 
                            Padding="6 3" 
                            Margin="0,0,10,0"
                            >
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Ученики" Foreground="{StaticResource DarkPinkBg}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Group.StudentCount, FallbackValue='0'}" 
                                       Foreground="{StaticResource VeryDarkPinkBg}" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InpBg}" 
                            CornerRadius="6" 
                            Padding="6 3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Занятий всего" Foreground="#666666" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Group.ClassesCount, FallbackValue='0'}" 
                                       Foreground="#222222" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" CornerRadius="8" Margin="10,5,10,10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="JournalGrid" Background="White" ShowGridLines="True"/>
                </ScrollViewer>
            </Border>

        </DockPanel>
    </Grid>
</Window>
