<Window x:Class="NeUrokAdmin.WPF.Views.ModalWindows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeUrokAdmin.WPF.Views.ModalWindows"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Вход"
        MinWidth="1080"
        SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Дни рождения скоро"
                Style="{StaticResource HeaderText}"
                TextAlignment="Center"
                Margin="0,20,0,10"/>
            <Border BorderBrush="{StaticResource DarkPinkBg}"
                    BorderThickness="3"
                    MinHeight="300"
                    Margin="0 0 0 20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Сегодня"
                                 Style="{StaticResource HeaderText}"
                                 TextAlignment="Center"
                                 Margin="0,0,0,3" FontSize="18"/>
                            <ScrollViewer BorderBrush="{StaticResource DarkPinkBg}"
                                          BorderThickness="0 0 0 1" 
                                          VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding UpcomingBirthdays.TodayBirthdays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Margin="5,3">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                        <Binding Path="Key" />
                                                        <Binding Path="Value" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Завтра"
                                 Style="{StaticResource HeaderText}"
                                 TextAlignment="Center"
                                 Margin="0,0,0,3" FontSize="18"/>
                            <ScrollViewer BorderBrush="{StaticResource DarkPinkBg}"
                                          BorderThickness="0 0 0 1" 
                                          VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding UpcomingBirthdays.TomorrowBirthdays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Margin="5,3">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                        <Binding Path="Key" />
                                                        <Binding Path="Value" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Послезавтра"
                                 Style="{StaticResource HeaderText}"
                                 TextAlignment="Center"
                                 Margin="0,0,0,3" FontSize="18"/>
                            <ScrollViewer BorderBrush="{StaticResource DarkPinkBg}"
                                          BorderThickness="0 0 0 1" 
                                          VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding UpcomingBirthdays.PostTomorrowBirthdays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Margin="5,3">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                        <Binding Path="Key" />
                                                        <Binding Path="Value" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Margin="30 15">
            <Image Source="/Resources/Icons/LogoIcon.png"
            Width="87"
            RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Добро пожаловать!"
                Style="{StaticResource HeaderText}"
                TextAlignment="Center"
                Margin="0,20,0,10"/>
            <StackPanel Margin="0,0,0,20">
                <TextBox x:Name="LoginInp"
                         Style="{StaticResource PlaceholderTextBoxStyle}"/>

                <Grid Style="{StaticResource PasswordWithPlaceholderStyle}" Margin="0 15 0 0">
                    <PasswordBox x:Name="PassInp" 
                     Style="{StaticResource PlaceholderPasswordBoxStyle}" Height="30"
                                 PasswordChanged="PassInp_PasswordChanged"/>
                    <TextBlock x:Name="placeholderText" 
                       Text="Пароль"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="7 0"
                       FontStyle="Italic"       
                       IsHitTestVisible="False" 
                       VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel>
                <Button Style="{StaticResource PrimaryBtn}" 
                        x:Name="LoginBtn"
                        Content="Войти"
                        Click="LoginBtn_Click"/>
                <Button Style="{StaticResource SecondaryBtn}" 
                        x:Name="RegBtn"
                        Content="Зарегистрироваться" 
                        Margin="0 10"
                        Click="RegBtn_Click"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="2">
            <StackPanel>
                <TextBlock Text="Истекающие абонементы"
         Style="{StaticResource HeaderText}"
         TextAlignment="Center"
         Margin="0,20,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MinWidth="515"
                          MaxHeight="130">
                    <DataGrid  
                     ItemsSource="{Binding ExpiringSubscriptions}" 
                     Style="{StaticResource MainDataGridStyle}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False" 
                     IsReadOnly="True">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="WrapStyle">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО"
                                        Binding="{Binding ClientFullname}"/>
                            <DataGridTextColumn Header="Окончание" Binding="{Binding FinishDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="Auto"/>
                            <DataGridTextColumn Header="Курс" Binding="{Binding CourseName}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Оплачен" Binding="{Binding IsPaid}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
